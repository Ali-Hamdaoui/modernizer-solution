{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rewrite_plugin_plan",
  "type": "object",
  "required": ["schema_version", "status", "transformer_guidance", "openrewrite", "apply_goals_forbidden"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "status": {"type": "string", "enum": ["USED", "SKIPPED", "FAILED"]},
    "profile_id": {"type": ["string", "null"]},
    "catalog_path": {"type": ["string", "null"]},
    "catalog_id": {"type": ["string", "null"]},
    "plugin": {"type": ["string", "null"]},
    "recipe_artifacts": {},
    "active_recipes": {},
    "preview_goals": {"type": "array", "items": {"type": "string"}},
    "selected_preview_goal": {"type": ["string", "null"]},
    "apply_goals_forbidden": {"type": "boolean", "const": true},
    "transformer_guidance": {"type": "string"},
    "openrewrite": {"type": "object"}
  },
  "additionalProperties": true
}
