{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "test_report",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "run_id",
    "phase",
    "test_status",
    "totals",
    "command",
    "cwd",
    "sandbox_path",
    "execution_owner",
    "execution_mode",
    "report_paths",
    "test_log_path",
    "source_log_path",
    "created_at",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "agent": {"type": "string", "enum": ["test-agent"]},
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "enum": ["post_transform"]},
    "test_status": {"type": "string", "enum": ["TEST_PASSED", "TEST_FAILED", "TEST_ERROR"]},
    "totals": {
      "type": "object",
      "required": ["tests", "passed", "failures", "errors", "skipped"],
      "properties": {
        "tests": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "command": {"type": "array", "items": {"type": "string"}},
    "cwd": {"type": ["string", "null"]},
    "sandbox_path": {"type": "string", "minLength": 1},
    "execution_owner": {"type": "string", "enum": ["build-agent"]},
    "execution_mode": {"type": "string", "enum": ["parse_existing_surefire"]},
    "report_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "test_log_path": {"type": "string", "minLength": 1},
    "source_log_path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "artifact_refs": {
      "type": "object",
      "required": ["self", "summary", "log"],
      "properties": {
        "self": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "log": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
