{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "repair_summary",
    "failure_classification",
    "skills_claimed",
    "wrapper_checklist",
    "patch_proposals",
    "security_review_required",
    "confidence",
    "refusals",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repair_summary": {"type": "string"},
    "failure_classification": {"type": "string"},
    "skills_claimed": {"type": "array", "items": {"type": "string"}},
    "skills_applied": {"type": "array", "items": {"type": "string"}},
    "wrapper_checklist": {
      "type": "object",
      "required": [
        "legacy_source_not_modified",
        "sandbox_only",
        "no_deployment",
        "no_pr_creation",
        "no_security_weakening",
        "h2_only_runtime_scope",
        "sql_server_out_of_scope",
        "endpoint_smoke_out_of_scope"
      ],
      "properties": {
        "legacy_source_not_modified": {"type": "boolean"},
        "sandbox_only": {"type": "boolean"},
        "no_deployment": {"type": "boolean"},
        "no_pr_creation": {"type": "boolean"},
        "no_security_weakening": {"type": "boolean"},
        "h2_only_runtime_scope": {"type": "boolean"},
        "sql_server_out_of_scope": {"type": "boolean"},
        "endpoint_smoke_out_of_scope": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "patch_proposals": {"type": "array"},
    "security_review_required": {"type": "boolean"},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "refusals": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
