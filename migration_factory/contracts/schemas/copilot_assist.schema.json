{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "copilot_assist",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "agent",
    "phase",
    "status",
    "provider",
    "model",
    "inputs_summary",
    "advisory_summary",
    "warnings",
    "error",
    "can_modify_source",
    "can_modify_plan",
    "can_modify_blockers",
    "can_modify_executable",
    "can_modify_unit_order",
    "can_modify_approval_decision",
    "can_modify_tools",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "enum": ["planning_agent"]},
    "phase": {"type": "string", "enum": ["planning"]},
    "status": {
      "type": "string",
      "enum": ["USED", "SKIPPED", "UNAVAILABLE", "ERROR"]
    },
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "inputs_summary": {"type": "object"},
    "advisory_summary": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {"type": ["string", "null"]},
    "can_modify_source": {"type": "boolean", "const": false},
    "can_modify_plan": {"type": "boolean", "const": false},
    "can_modify_blockers": {"type": "boolean", "const": false},
    "can_modify_executable": {"type": "boolean", "const": false},
    "can_modify_unit_order": {"type": "boolean", "const": false},
    "can_modify_approval_decision": {"type": "boolean", "const": false},
    "can_modify_tools": {"type": "boolean", "const": false},
    "artifact_refs": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
