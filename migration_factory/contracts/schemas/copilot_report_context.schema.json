{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "copilot_report_context",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "statuses",
    "approval",
    "migration_units",
    "openrewrite",
    "transformation",
    "build",
    "tests",
    "security",
    "scope_limits",
    "artifact_refs",
    "provenance",
    "warnings",
    "blockers",
    "errors"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "required": ["id", "risk_level", "source_stack", "target_stack"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "risk_level": {"type": ["string", "null"]},
        "source_stack": {"type": "object"},
        "target_stack": {"type": "object"}
      },
      "additionalProperties": true
    },
    "statuses": {
      "type": "object",
      "required": ["final", "orchestration", "approval", "transform", "build", "tests"],
      "additionalProperties": {"type": ["string", "null", "boolean", "number", "object", "array"]}
    },
    "approval": {
      "type": "object",
      "required": ["status", "decision", "decided_by", "decided_at", "plan_lock_ref", "lock_status"],
      "additionalProperties": true
    },
    "migration_units": {
      "type": "object",
      "required": ["count", "units", "source"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "units": {"type": "array", "items": {"type": "object"}},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "openrewrite": {
      "type": "object",
      "required": ["status", "unit_id", "plugin", "recipe_artifacts", "active_recipes", "apply_goal", "apply_maven_args"],
      "additionalProperties": true
    },
    "transformation": {
      "type": "object",
      "required": ["status", "sandbox_path", "plan_target", "current_unit", "blocked_unit", "next_unit_index"],
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["status", "command", "validations", "log_ref"],
      "additionalProperties": true
    },
    "tests": {
      "type": "object",
      "required": ["status", "totals", "execution_owner", "execution_mode", "report_paths"],
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": ["status", "security_config_touched", "warnings"],
      "additionalProperties": true
    },
    "scope_limits": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {
      "type": "object",
      "required": ["report_context"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[^#]+(#/.*)?$"
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
